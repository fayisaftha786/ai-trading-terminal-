# Public-market data adapter (must be an exchange you are legally eligible to use)
CEX_EXCHANGE=coinbase
CEX_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# Jupiter Tokens API v2. Keyless access is rate-limited; add your own key if you obtain one.
JUPITER_BASE_URL=https://api.jup.ag/tokens/v2
JUPITER_API_KEY=

# Local paper portfolio only. No live trading feature is enabled in this release.
PAPER_INITIAL_CAPITAL_USD=10
DATABASE_PATH=data/trading.db
MARKET_CACHE_SECONDS=20
APP_ENV=development
# Production/cloud mode: set APP_ENV=production, a 16+ character password,
# and a random APP_AUTH_SECRET with at least 32 bytes. Never commit real values.
APP_USERNAME=admin
APP_PASSWORD=
APP_AUTH_SECRET=
APP_TOKEN_TTL_MINUTES=480


# Coinbase Advanced Trade v3 — guarded real SPOT LIMIT orders.
# Keep all switches OFF until account preflight, eligible products and risk caps are verified.
# CDP API key must have VIEW + TRADE only; TRANSFER permission must be disabled.
# Store the API key and PEM private key only as Cloudflare Worker secrets, never in Git.
COINBASE_ADVANCED_API_KEY=
COINBASE_ADVANCED_API_SECRET=
COINBASE_ADVANCED_ALLOWED_PRODUCTS=
COINBASE_ADVANCED_MAX_ORDER_QUOTE=
COINBASE_ADVANCED_MAX_OPEN_ORDERS=1
COINBASE_ADVANCED_MAX_DAILY_ORDERS=1
COINBASE_ADVANCED_ORDER_ENABLED=false
