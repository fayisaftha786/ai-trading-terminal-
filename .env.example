# Public-market data adapter (must be an exchange you are legally eligible to use)
CEX_EXCHANGE=binance
CEX_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# Jupiter Tokens API v2. Keyless access is rate-limited; add your own key if you obtain one.
JUPITER_BASE_URL=https://api.jup.ag/tokens/v2
JUPITER_API_KEY=

# Local paper portfolio only. No live trading feature is enabled in this release.
PAPER_INITIAL_CAPITAL_USD=100
DATABASE_PATH=data/trading.db
MARKET_CACHE_SECONDS=20
APP_ENV=development
# Production/cloud mode: set APP_ENV=production, a 16+ character password,
# and a random APP_AUTH_SECRET with at least 32 bytes. Never commit real values.
APP_USERNAME=admin
APP_PASSWORD=
APP_AUTH_SECRET=
APP_TOKEN_TTL_MINUTES=480

# Binance Spot Testnet ONLY. Create keys at the official Spot Test Network site.
# Keep these values on your own device/server; never paste them into ChatGPT.
BINANCE_TESTNET_ENABLED=false
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# Explicit gate for bounded LIMIT orders on Spot Testnet only; keep disabled until you opt in.
BINANCE_TESTNET_ORDER_ENABLED=false
BINANCE_TESTNET_MAX_ORDER_USDT=10
BINANCE_TESTNET_MAX_OPEN_ORDERS=3

# Binance production account connection — READ ONLY ONLY.
# Create a separate API key with reading / USER_DATA permission only.
# Do not enable Spot Trading or withdrawals. Store values only in private server secrets.
BINANCE_READONLY_ENABLED=false
BINANCE_READONLY_API_KEY=
BINANCE_READONLY_API_SECRET=
