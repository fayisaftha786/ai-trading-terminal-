{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-trading-terminal",
  "main": "src/index.js",
  "compatibility_date": "2026-11-07",
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [
      { "name": "TRADING_ENGINE", "class_name": "TradingEngine" },
      { "name": "AUTH_RATE_LIMITER", "class_name": "AuthRateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TradingEngine"] },
    { "tag": "v2", "new_sqlite_classes": ["AuthRateLimiter"] }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
